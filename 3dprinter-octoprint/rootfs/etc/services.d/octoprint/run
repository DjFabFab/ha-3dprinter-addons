#!/usr/bin/with-contenv bashio
# ==============================================================================
# Add-on: 3dprinter-octoprint
# Runs OctoPrint
# ==============================================================================

bashio::log.info "Starting OctoPrint..."

## Run your program
# Note: /opt/octoprint/bin/octoprint uses shebang /usr/bin/python3 so plugin manager resolves to non-venv interpreter and user-site works.
exec /opt/octoprint/bin/octoprint --basedir /data/config/octoprint serve --iknowwhatimdoing --host 127.0.0.1 --port 80
